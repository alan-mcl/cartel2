{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-gdscript-class": "FuelDef",
  "x-catalog-file": "fuels.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "price_min", "price_max"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "price_min": { "type": "number" },
    "price_max": { "type": "number" },
    "tank_scale": {
      "type": "number",
      "default": 1,
      "x-note": "Fraction of a tank module's rated capacity stored for this fuel. The engine bunker is not scaled. Omitted means 1."
    }
  }
}
