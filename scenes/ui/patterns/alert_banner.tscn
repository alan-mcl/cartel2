[gd_scene format=3 uid="uid://cartel_pattern_alert"]

[node name="AlertBanner" type="PanelContainer"]
theme_type_variation = &"Alert"

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Tag" type="Label" parent="HBox"]
layout_mode = 2
theme_type_variation = &"Alert"
text = "ALERT"

[node name="Message" type="Label" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Section"
text = "Status message"
