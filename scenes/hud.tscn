[gd_scene load_steps=2 format=3 uid="uid://cartel_hud"]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Root/Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="HintLabel" type="Label" parent="Root/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.82, 0.95, 0.9)
text = "W/↑ thrust · S/↓ reverse · A/D rotate · Shift boost · E interact · Esc pause"

[node name="ShipLabel" type="Label" parent="Root/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.92, 1, 1)
text = "Ship: Flare-ON SS · Flare-ON Chassis · Mark 3 Fusion"

[node name="StatsRow" type="HBoxContainer" parent="Root/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="SpeedLabel" type="Label" parent="Root/Margin/VBox/StatsRow"]
layout_mode = 2
text = "Speed: 0"

[node name="HeadingLabel" type="Label" parent="Root/Margin/VBox/StatsRow"]
layout_mode = 2
text = "Heading: 0°"

[node name="BoostLabel" type="Label" parent="Root/Margin/VBox/StatsRow"]
layout_mode = 2
text = "Boost: --"

[node name="LocationLabel" type="Label" parent="Root/Margin/VBox"]
layout_mode = 2
text = "Location: Proxima near orbit"

[node name="ObjectiveLabel" type="Label" parent="Root/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.45, 1)
text = "Objective: Investigate the wreck near Beacon 3"

[node name="TargetLabel" type="Label" parent="Root/Margin/VBox"]
layout_mode = 2
text = "Target: none"

[node name="CreditsLabel" type="Label" parent="Root/Margin/VBox"]
layout_mode = 2
text = "Credits: d3000"

[node name="LogLabel" type="Label" parent="Root/Margin/VBox"]
layout_mode = 2
autowrap_mode = 3
theme_override_colors/font_color = Color(0.7, 0.78, 0.88, 1)
text = "Flare-ON SS ready. Thrusters online."

[node name="HullLabel" type="Label" parent="Root/Margin/VBox"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.55, 1, 1)
text = "Hull: 18 / 18"

[node name="BoundaryLabel" type="Label" parent="Root/Margin/VBox"]
