extends SceneTree


func _init() -> void:
	var runner := TestRunner.new()
	TestCatalog.run(runner)
	TestUiRegistry.run(runner)
	TestGameScreen.run(runner, self)
	TestSession.run(runner)
	TestTranslation.run(runner)
	TestVolatileTranslation.run(runner)
	TestSave.run(runner)
	TestCareer.run(runner)
	TestSanctions.run(runner)
	TestRepairs.run(runner)
	TestAssembler.run(runner)
	TestCombat.run(runner)
	TestCombatPersistence.run(runner)
	TestBallisticHit.run(runner)
	TestProjectGuidance.run(runner)
	TestSensors.run(runner)
	TestTargetLock.run(runner)
	TestTargetScan.run(runner)
	TestAutopilot.run(runner)
	TestFieldConditions.run(runner)
	TestEconomy.run(runner)
	TestCommodityCargo.run(runner)
	TestCargoRequirements.run(runner)
	TestClock.run(runner)
	TestSimulation.run(runner)
	TestEvents.run(runner)
	TestMissions.run(runner)
	TestCharterResolution.run(runner)
	TestCharterBoard.run(runner)
	TestScanCharters.run(runner)
	TestBountyCharters.run(runner)
	TestFreight.run(runner)
	TestCharterHopsDeadlines.run(runner)
	TestTraffic.run(runner, self)
	TestCorporatePresence.run(runner)
	TestShipSim.run(runner)
	TestShipVisual.run(runner)
	TestPresentation.run(runner)
	TestPlanetSurfaceLabels.run(runner)
	TestFlightSandbox.run(runner)
	TestMotion.run(runner)
	TestDebris.run(runner)
	TestMessageBar.run(runner, self)
	TestMessageEmitters.run(runner)
	TestCorporateOfficeTape.run(runner)
	TestExchangePriceTape.run(runner)
	TestFuel.run(runner)
	TestFlightManifest.run(runner)
	TestBalanceMetrics.run(runner)
	TestWeaponMountBands.run(runner)
	TestTemplatePower.run(runner)
	TestModuleDominance.run(runner)

	if runner.failures > 0:
		print("=== %d test failure(s) ===" % runner.failures)
		quit(1)
	else:
		print("=== all tests passed ===")
		quit(0)
